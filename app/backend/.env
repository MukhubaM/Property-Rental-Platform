# Application
SPRING_APPLICATION_NAME=platform

# Server
SERVER_PORT=8080

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/property_rental
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DRIVER=org.postgresql.Driver

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Flyway Migrations
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration

# Error Handling
ERROR_INCLUDE_MESSAGE=never
ERROR_INCLUDE_BINDING_ERRORS=never
ERROR_INCLUDE_STACKTRACE=never